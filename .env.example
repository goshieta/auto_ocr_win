# OCR Server URL (required)
# The endpoint to which OCR results will be POSTed as JSON.
OCR_SERVER_URL=http://localhost:8080/api/ocr

# HTTP request timeout in seconds (optional, defaults to 3)
OCR_REQUEST_TIMEOUT_SECS=3
# Device name sent with each payload (optional, defaults to COMPUTERNAME)
OCR_DEVICE_NAME=
